# Postgres connection used by the API, worker and scheduler.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hub

# Shared secret used to verify the HMAC-SHA256 signature on inbound webhooks.
# Per-source secrets can be set as WEBHOOK_SECRET_ATS, WEBHOOK_SECRET_ESIGN, ...
WEBHOOK_SECRET=change-me

# Slack delivery: sandbox (stored in Postgres), console (printed), or webhook.
SLACK_MODE=sandbox
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#ops-alerts

# Email delivery: sandbox, console, or smtp.
EMAIL_MODE=sandbox
SMTP_HOST=
SMTP_PORT=587

# Base URL used in alert messages so a timeline link opens the ops page.
PUBLIC_BASE_URL=http://localhost:8000

# Worker identity and polling interval in seconds.
WORKER_ID=worker-1
WORKER_POLL_SECONDS=1.0
